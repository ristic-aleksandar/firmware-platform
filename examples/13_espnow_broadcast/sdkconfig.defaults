# Defaults for the 13_espnow_broadcast example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses (selects e32p_wifi -> nvs, event).
CONFIG_E32P_ESPNOW_ENABLE=y
