# Defaults for the 24_modbus example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses (modbus selects uart).
CONFIG_E32P_MODBUS_ENABLE=y
