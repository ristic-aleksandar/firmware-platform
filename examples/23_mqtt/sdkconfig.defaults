# Defaults for the 23_mqtt example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses (mqtt over a Wi-Fi station).
CONFIG_E32P_WIFI_ENABLE=y
CONFIG_E32P_MQTT_ENABLE=y
