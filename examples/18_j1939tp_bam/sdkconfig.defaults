# Defaults for the 18_j1939tp_bam example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses (j1939tp selects j1939, which selects twai).
CONFIG_E32P_J1939TP_ENABLE=y
