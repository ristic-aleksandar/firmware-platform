# Defaults for the 12_wifi_sta example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses.
CONFIG_E32P_WIFI_ENABLE=y

# Wi-Fi credentials are set via menuconfig (Example Wi-Fi Configuration).
# Do NOT commit real credentials here.
