# Defaults for the Unity test runner.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Enable every module so the code under test is compiled in.
CONFIG_E32P_PIN_GUARDS=y
CONFIG_E32P_GPIO_ENABLE=y
CONFIG_E32P_LEDC_ENABLE=y
CONFIG_E32P_EVENT_ENABLE=y
CONFIG_E32P_NVS_ENABLE=y
CONFIG_E32P_SYSINFO_ENABLE=y
CONFIG_E32P_WDT_ENABLE=y
CONFIG_E32P_UART_ENABLE=y
CONFIG_E32P_I2C_ENABLE=y
CONFIG_E32P_SPI_ENABLE=y
CONFIG_E32P_ADC_ENABLE=y
CONFIG_E32P_GPTIMER_ENABLE=y
CONFIG_E32P_DAC_ENABLE=y
CONFIG_E32P_TOUCH_ENABLE=y
CONFIG_E32P_PCNT_ENABLE=y
CONFIG_E32P_WIFI_ENABLE=y
CONFIG_E32P_ESPNOW_ENABLE=y
CONFIG_E32P_TWAI_ENABLE=y
CONFIG_E32P_I2S_ENABLE=y
CONFIG_E32P_WS2812_ENABLE=y
CONFIG_E32P_J1939_ENABLE=y
CONFIG_E32P_J1939TP_ENABLE=y
CONFIG_E32P_ISOTP_ENABLE=y
CONFIG_E32P_OBD2_ENABLE=y
CONFIG_E32P_UDS_ENABLE=y
CONFIG_E32P_J1939_ACL_ENABLE=y
CONFIG_E32P_BMP280_ENABLE=y
CONFIG_E32P_TM1637_ENABLE=y
CONFIG_E32P_PM_ENABLE=y
CONFIG_E32P_MQTT_ENABLE=y
CONFIG_E32P_MODBUS_ENABLE=y
CONFIG_E32P_OTA_ENABLE=y
# e32p_ble: enabled for the pure adv/UUID tests. Bluetooth host intentionally
# left OFF so the runner stays lean (device fns return NOT_SUPPORTED here).
CONFIG_E32P_BLE_ENABLE=y
