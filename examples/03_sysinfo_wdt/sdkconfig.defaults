# Defaults for the 03_sysinfo_wdt example.

# 4 MB flash with the platform's dual-OTA partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions.csv"

# Cherry-pick the modules this example uses.
CONFIG_E32P_SYSINFO_ENABLE=y
CONFIG_E32P_WDT_ENABLE=y
