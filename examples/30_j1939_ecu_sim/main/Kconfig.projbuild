menu "30_j1939_ecu_sim"

    config ECU_CAN_TX_GPIO
        int "CAN TX GPIO"
        default 4 if IDF_TARGET_ESP32S3
        default 21
        help
            TWAI (CAN) TX pin, wired to the transceiver's TXD. Defaults match the
            bench pin map per chip (WROOM 21, S3 4 — the S3 has no GPIO 22-25).
            Avoid the strapping pins.

    config ECU_CAN_RX_GPIO
        int "CAN RX GPIO"
        default 5 if IDF_TARGET_ESP32S3
        default 22
        help
            TWAI (CAN) RX pin, wired to the transceiver's RXD. Defaults match the
            bench pin map per chip (WROOM 22, S3 5).

endmenu
