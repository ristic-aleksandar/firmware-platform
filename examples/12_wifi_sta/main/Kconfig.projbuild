menu "Example Wi-Fi Configuration"

    config E32P_EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) for the example to connect to.

    config E32P_EXAMPLE_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi passphrase. Leave empty for an open network.

endmenu
